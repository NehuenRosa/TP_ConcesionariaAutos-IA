# Puertos y host
# PUERTO del backend (API)
PUERTO_API=8080
# Host donde escucha la API
HOST_API=0.0.0.0

# Base de datos (PostgreSQL)
# Modo local: variables por partes
BD_HOST=localhost
BD_PUERTO=5432
BD_USUARIO=concesionaria
# OBLIGATORIO: docker compose falla si no está definida. Usar un valor fuerte.
# Generar en PowerShell:
#   $env:BD_PASSWORD = -join ((1..24) | ForEach-Object { [char](48..122 | Get-Random -Count 1) })
BD_PASSWORD=concesionaria
BD_NOMBRE=concesionaria
BD_SSL=disable
# Modo nube (opcional): URL completa que pisa las variables BD_* (p. ej. en
# Render). Ej: postgres://usuario:password@host:puerto/concesionaria
# BD_URL=

# Autenticación JWT
# Secreto para firmar los tokens JWT.
# OBLIGATORIO: docker compose falla si no está definida. Usar un valor fuerte:
#   $env:JWT_SECRETO = -join ((1..32) | ForEach-Object { [char](48..122 | Get-Random -Count 1) })
JWT_SECRETO=cambiar-en-produccion

# Cifrado de cotizaciones
# Clave para cifrar (AES-256-GCM) el contenido de los mensajes de las
# cotizaciones en reposo. Si se deja vacía, el backend usa JWT_SECRETO como
# respaldo. Recomendado: usar una clave distinta de JWT_SECRETO.
#   $env:CLAVE_ENCRIPTACION = -join ((1..32) | ForEach-Object { [char](48..122 | Get-Random -Count 1) })
CLAVE_ENCRIPTACION=

# Chatbot (LLM)
# PROVEEDOR_LLM: proveedor del LLM. Actualmente solo se soporta "googleai"
# (Gemini en la nube).
PROVEEDOR_LLM=
# API key de Gemini (nube): gratis en https://aistudio.google.com -> "Get API
# key", sin tarjeta de crédito. Con la clave, el chatbot y la tasación corren
# en Google Cloud y no consumen recursos locales. Contexto de 1M de tokens y
# free tier generoso (gemini-3.5-flash-lite, versión estable del más liviano).
GOOGLE_API_KEY=
# Modelo para el chat y la comparación de vehículos. Vacío = el backend elige
# el default (gemini-3.5-flash-lite). Se puede forzar uno específico acá.
MODELO_CHATBOT=
# Modelo de visión para la tasación por fotos. Vacío = default
# (gemini-3.5-flash-lite).
MODELO_VISION=
# API pública de valores de referencia de autos usados (Guía de la CCA,
# Cámara del Comercio Automotor). La tasación usa estos valores reales y no
# inventa precios.
ARGAUTOS_URL=https://argautos.com/api/v1

# "Continuar con Google" (CU-11)
# Client ID OAuth 2.0 tipo "Aplicación web" de Google Cloud Console
# (https://console.cloud.google.com/apis/credentials), con el origen del
# frontend autorizado (ej. http://localhost:5173). Vacío = acceso con Google
# deshabilitado: el backend responde 503 y el frontend oculta el botón.
GOOGLE_CLIENT_ID=
# Reservado para flujos futuros con código de autorización; el flujo actual
# por ID token no lo necesita.
GOOGLE_CLIENT_SECRET=

# Retención de conversaciones (privacidad)
# Días que se conservan las conversaciones cerradas (cotizaciones y consultas)
# antes de que el job interno las purgue. Nunca se borran conversaciones
# abiertas ni cerradas dentro del plazo. Default: 180.
RETENCION_CONVERSACIONES_DIAS=180

# Seña de reserva (CU-08)
# Datos bancarios que se muestran al cliente para transferir la seña (5 % del
# valor del vehículo). Vacíos = la UI indica que el personal pasará los datos.
CBU_CONCESIONARIA=
ALIAS_CONCESIONARIA=

# Frontend
# URL base de la API para el frontend (dev)
VITE_API_URL=http://localhost:8080/api

# GitHub MCP (opencode)
# Token de acceso personal (PAT) para autenticar el servidor MCP de GitHub.
# Crear en https://github.com/settings/personal-access-tokens con los permisos
# necesarios (repo, read:user, etc.) y exponerlo como variable de entorno real
# antes de iniciar opencode (ej. $env:GITHUB_TOKEN="..." en PowerShell).
GITHUB_TOKEN=
