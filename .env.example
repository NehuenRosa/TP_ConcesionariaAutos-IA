# Puertos y host
# PUERTO del backend (API)
PUERTO_API=8080
# Host donde escucha la API
HOST_API=0.0.0.0

# Base de datos (PostgreSQL)
# Modo local: variables por partes
BD_HOST=localhost
BD_PUERTO=5432
BD_USUARIO=concesionaria
# OBLIGATORIO: docker compose falla si no está definida. Usar un valor fuerte.
# Generar en PowerShell:
#   $env:BD_PASSWORD = -join ((1..24) | ForEach-Object { [char](48..122 | Get-Random -Count 1) })
BD_PASSWORD=concesionaria
BD_NOMBRE=concesionaria
BD_SSL=disable
# Modo nube (opcional): URL completa que pisa las variables BD_* (p. ej. en
# Render). Ej: postgres://usuario:password@host:puerto/concesionaria
# BD_URL=

# Autenticación JWT
# Secreto para firmar los tokens JWT.
# OBLIGATORIO: docker compose falla si no está definida. Usar un valor fuerte:
#   $env:JWT_SECRETO = -join ((1..32) | ForEach-Object { [char](48..122 | Get-Random -Count 1) })
JWT_SECRETO=cambiar-en-produccion

# Chatbot (LLM)
# PROVEEDOR_LLM: "googleai" (nube, recomendado) u "ollama" (local). Si se deja
# vacío, se usa googleai cuando hay GOOGLE_API_KEY y ollama como respaldo.
PROVEEDOR_LLM=
# API key de Gemini (nube): gratis en https://aistudio.google.com -> "Get API
# key", sin tarjeta de crédito. Con la clave, el chatbot y la tasación corren
# en Google Cloud y no consumen recursos locales. Contexto de 1M de tokens y
# free tier generoso (gemini-flash-lite-latest, alias estable del más liviano).
GOOGLE_API_KEY=
# URL base de Ollama (solo si usás el proveedor local). Por defecto
# docker-compose.yml apunta al Ollama nativo del host
# (http://host.docker.internal:11434). Si preferís Ollama en contenedor con
# GPU, levantarlo con `--profile ollama-contenedor` y usar http://ollama:11434.
OLLAMA_URL=http://localhost:11434
# Modelo para el chat y la comparación de vehículos. Vacío = el backend elige
# el default según el proveedor (googleai -> gemini-flash-lite-latest, ollama ->
# llama3). Se puede forzar uno específico acá.
MODELO_CHATBOT=
# Modelo de visión para la tasación por fotos. Vacío = default según el
# proveedor (googleai -> gemini-flash-lite-latest, ollama -> minicpm-v).
MODELO_VISION=
# API pública de valores de referencia de autos usados (Guía de la CCA,
# Cámara del Comercio Automotor). La tasación usa estos valores reales y no
# inventa precios.
ARGAUTOS_URL=https://argautos.com/api/v1
# Nota (proveedor ollama): con el Ollama nativo del host, descargar los
# modelos así:
#   ollama pull llama3
#   ollama pull minicpm-v
# Con el contenedor (--profile ollama-contenedor):
#   docker compose --profile ollama-contenedor exec ollama ollama pull llama3
#   docker compose --profile ollama-contenedor exec ollama ollama pull minicpm-v
# Nota GPU: si usás Ollama en contenedor, docker-compose.yml expone la GPU
# (requiere NVIDIA Container Toolkit instalado); sin GPU, Ollama corre por CPU.
# El Ollama nativo de Windows ya usa la GPU por sí solo.

# Frontend
# URL base de la API para el frontend (dev)
VITE_API_URL=http://localhost:8080/api

# GitHub MCP (opencode)
# Token de acceso personal (PAT) para autenticar el servidor MCP de GitHub.
# Crear en https://github.com/settings/personal-access-tokens con los permisos
# necesarios (repo, read:user, etc.) y exponerlo como variable de entorno real
# antes de iniciar opencode (ej. $env:GITHUB_TOKEN="..." en PowerShell).
GITHUB_TOKEN=
