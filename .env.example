# Puertos y host
# PUERTO del backend (API)
PUERTO_API=8080
# Host donde escucha la API
HOST_API=0.0.0.0

# Base de datos (PostgreSQL)
# Modo local: variables por partes
BD_HOST=localhost
BD_PUERTO=5432
BD_USUARIO=concesionaria
BD_PASSWORD=concesionaria
BD_NOMBRE=concesionaria
BD_SSL=disable
# Modo nube (opcional): URL completa que pisa las variables BD_* (p. ej. en
# Render). Ej: postgres://usuario:password@host:puerto/concesionaria
# BD_URL=

# Autenticación JWT
# Secreto para firmar los tokens JWT (cambiar en producción)
JWT_SECRETO=cambiar-en-produccion

# Chatbot (Ollama)
# URL base de Ollama (usar http://ollama:11434 dentro de Docker Compose)
OLLAMA_URL=http://localhost:11434
# Modelo para el chat y la comparación de vehículos
MODELO_CHATBOT=llama3
# Modelo de visión para la tasación por fotos.
# minicpm-v (~3.2 GB) entra junto a llama3 en 8 GB de VRAM; si tu GPU tiene
# más memoria podés usar llama3.2-vision (~7.9 GB).
MODELO_VISION=minicpm-v
# API pública de valores de referencia de autos usados (Guía de la CCA,
# Cámara del Comercio Automotor). La tasación usa estos valores reales y no
# inventa precios.
ARGAUTOS_URL=https://argautos.com/api/v1
# Nota: con Docker Compose, descargar los modelos dentro del contenedor:
#   docker compose exec ollama ollama pull llama3
#   docker compose exec ollama ollama pull minicpm-v
# Nota GPU: docker-compose.yml expone la GPU al contenedor de Ollama (requiere
# NVIDIA Container Toolkit instalado). Sin GPU, Ollama corre por CPU.

# Frontend
# URL base de la API para el frontend (dev)
VITE_API_URL=http://localhost:8080/api

# GitHub MCP (opencode)
# Token de acceso personal (PAT) para autenticar el servidor MCP de GitHub.
# Crear en https://github.com/settings/personal-access-tokens con los permisos
# necesarios (repo, read:user, etc.) y exponerlo como variable de entorno real
# antes de iniciar opencode (ej. $env:GITHUB_TOKEN="..." en PowerShell).
GITHUB_TOKEN=
